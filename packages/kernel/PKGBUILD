# ALARM kernel + USB-C DP + matching headers and RKNN-compatible NPU driver.
# ALARM source commit: 0e55b970ab6f10c2c1b1bbe8e31bbd3d9ca0e74b
pkgbase=linux-aarch64-emiya-rustpi
pkgname=("$pkgbase" "$pkgbase-headers" "$pkgbase-rknpu")
pkgver=7.2.12
pkgrel=1
_srcname=linux-7.2
_rknpu_commit=a6bcdb120b8a21255c6520f0504a13a5d37b9045
arch=('aarch64')
url='https://archlinuxarm.org/packages/aarch64/linux-aarch64'
license=('GPL-2.0-only')
makedepends=('bc' 'dtc' 'pahole' 'python' 'kmod' 'flex' 'bison' 'openssl' 'libelf')
options=(!strip !debug !lto !buildflags)
source=(
  'https://www.kernel.org/pub/linux/kernel/v7.x/linux-7.2.tar.xz'
  'https://www.kernel.org/pub/linux/kernel/v7.x/patch-7.2.12.xz'
  '0001-arm64-dts-rockchip-disable-pwm0-on-rk3399-firefly.patch'
  '0002-pps-Compatibility-hack-should-be-X86-specific.patch'
  '0003-Revert-arm64-dts-rockchip-Move-rk3568-PCIe3-MSI-to-u.patch'
  '0004-serial-amba-pl011-add-arm-pl011-axi-binding-for-RP1.patch'
  '0005-arm64-dts-rpi5-add-RP1-UART0-GPIO14-15-console.patch'
  'rustpi-dp.patch.xz'
  'config'
  'dp-commits.txt'
  'rknpu-a6bcdb120b8a21255c6520f0504a13a5d37b9045.tar.gz::https://codeload.github.com/lurenJBD/rk3588-rknn-core/tar.gz/a6bcdb120b8a21255c6520f0504a13a5d37b9045'
  '60-rustpi-rknpu.conf'
  '60-rustpi-rknpu-load.conf'
)
sha256sums=(
